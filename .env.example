# Local sessions. Set to true only behind HTTPS.
COOKIE_SECURE=false

# Optional language model. The app runs without these and labels output as preliminary.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1/chat/completions
# AI_GATEWAY_MODEL=openai/gpt-4o-mini
# AI_DAILY_LIMIT=30

# Optional logo images. Requires OPENAI_API_KEY. Leave unset to keep editable logo sketches.
# AI_IMAGE_ENABLED=true
# OPENAI_IMAGE_MODEL=dall-e-3

# Optional explicit publish hook. The site export works without it.
# DEPLOY_HOOK_URL=https://example.com/hooks/deploy

# Optional Supabase project. The running app stores data in local SQLite until you switch adapters.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
